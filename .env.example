# ================================================================
#  Alpha Ultimate ERP v5 — Environment Variables
#  Copy this to .env.local for local dev.
#  Add ALL three to Vercel → Project Settings → Environment Variables
# ================================================================

# NeonDB PostgreSQL connection string
# Get from: https://console.neon.tech → your project → Connection Details
# MUST end with ?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-128-character-hex-secret-here-change-this-in-production

# ImgBB API key — free at https://api.imgbb.com (no credit card)
IMGBB_API_KEY=your-imgbb-api-key-here
